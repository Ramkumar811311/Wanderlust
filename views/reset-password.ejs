<% layout("/layouts/boilerplate") %>

    <style>
        body {
            background-color: #f7f7f7;
        }

        .login-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            background: #fff;
        }

        .form-control {
            border-radius: 10px;
            padding: 10px 14px;
        }

        .btn-custom {
            background-color: #ff385c;
            color: white;
            border-radius: 10px;
            padding: 10px;
            font-weight: 500;
        }

        .btn-custom:hover {
            background-color: #e03150;
        }

        .form-label {
            font-weight: 500;
        }

        .brand-title {
            font-weight: 600;
            margin-bottom: 20px;
            text-align: center;
        }

        a:hover {
            color: #e03150;
            text-decoration: underline;
        }
    </style>

    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-11 col-sm-8 col-md-6 col-lg-4">
            <div class="login-card">

                <h3 class="brand-title">Reset Password 🔐</h3>

                <form action="/reset-password" method="POST" class="needs-validation" novalidate>

                    <!-- Username -->
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input name="username" placeholder="Enter username" class="form-control" required>
                        <div class="invalid-feedback">
                            Please enter your username
                        </div>
                    </div>

                    <!-- New Password -->
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input name="password" type="password" placeholder="Enter new password" class="form-control"
                            required>
                        <div class="invalid-feedback">
                            Please enter a new password
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <input name="confirmPassword" type="password" class="form-control" required>
                    </div>

                    <!-- Button -->
                    <div class="d-grid">
                        <button class="btn btn-custom">Reset Password</button>
                    </div>

                </form>

                <!-- Back to login -->
                <div class="text-center mt-3">
                    <a href="/login" class="fw-semibold text-decoration-none" style="color: #ff385c;">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Login
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap Validation -->
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');

            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>